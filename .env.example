# ==============================================================================
# FieldFlow Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your credentials.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Neon Serverless PostgreSQL Pooled Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth Session Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your_generated_random_secret_here"

# Application Base URLs
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Optional: Demo Account Initial Password (Used by scripts/seed-demo.mjs)
DEMO_USER_PASSWORD="ChangeMeInProduction123!"
