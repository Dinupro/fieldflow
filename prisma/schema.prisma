// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DISPATCHER
  TECHNICIAN
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
  OFF
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  name          String?     @db.VarChar(100)
  email         String      @unique @db.VarChar(255)
  emailVerified Boolean     @default(false)
  image         String?
  passwordHash  String?
  role          UserRole?   @default(DISPATCHER)
  createdAt     DateTime    @default(now()) @db.Timestamp
  updatedAt     DateTime    @updatedAt @db.Timestamp

  sessions      Session[]
  accounts      Account[]

  technician    Technician?
  statusLogs    StatusLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamp
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt DateTime? @db.Timestamp
  refreshTokenExpiresAt DateTime? @db.Timestamp
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now()) @db.Timestamp
  updatedAt             DateTime  @updatedAt @db.Timestamp
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamp
  createdAt  DateTime @default(now()) @db.Timestamp
  updatedAt  DateTime @updatedAt @db.Timestamp

  @@map("verification")
}

model Technician {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @unique @db.Uuid
  name      String           @db.VarChar(100)
  phone     String?          @db.VarChar(20)
  skills    String[]
  status    TechnicianStatus
  createdAt DateTime         @default(now()) @db.Timestamp
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
}

model Customer {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(100)
  company    String?     @db.VarChar(100)
  email      String      @unique @db.VarChar(255)
  phone      String      @db.VarChar(20)
  address    String
  city       String?     @db.VarChar(100)
  notes      String?
  createdAt  DateTime    @default(now()) @db.Timestamp
  updatedAt  DateTime?   @updatedAt @db.Timestamp
  workOrders WorkOrder[]

  @@map("customer")
}

model WorkOrder {
  id              String          @id @default(uuid()) @db.Uuid
  technicianId    String?         @db.Uuid
  customerId      String          @db.Uuid
  title           String          @db.VarChar(200)
  description     String
  priority        Priority
  status          WorkOrderStatus
  scheduledAt     DateTime?       @db.Timestamp
  completionNotes String?
  createdAt       DateTime        @default(now()) @db.Timestamp
  updatedAt       DateTime        @updatedAt @db.Timestamp
  technician      Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  statusLogs      StatusLog[]
}

model StatusLog {
  id           String          @id @default(uuid()) @db.Uuid
  workOrderId  String          @db.Uuid
  changedById  String          @db.Uuid
  fromStatus   WorkOrderStatus
  toStatus     WorkOrderStatus
  changedAt    DateTime        @default(now()) @db.Timestamp
  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  changedBy    User            @relation(fields: [changedById], references: [id])
}
